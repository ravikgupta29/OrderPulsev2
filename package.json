{
  "name": "orderpulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d dist --nojekyll",
    "dev:int": "vite --mode int",
    "dev:val": "vite --mode val",
    "build": "tsc -b && vite build",
    "build:int": "tsc -b && vite build --mode int",
    "build:val": "tsc -b && vite build --mode val",
    "build:prod": "tsc -b && vite build --mode prod",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "build:pages": "tsc -b && vite build --mode pages",
    "postbuild:pages": "node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "msw": "^2.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
